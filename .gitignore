# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Go
bin/
*.test

# Coverage. All of it is generated by `just test-coverage` /
# `just fe-test-coverage` and rendered fresh by CI on every run; none of it is
# reviewable as a diff. The numbers that are meant to persist live in
# docs/testing/coverage.md.
coverage.out
coverage.html
frontend/coverage/
code-coverage-results.md
code-coverage-results-frontend.md

# Build artifacts
*.wasm
# `go build ./cmd/wasm` run from backend/ names its output after the package
# directory, so the artifact has no extension and the glob above misses it.
# The kernel the frontend actually loads is frontend/public/aconiq.wasm, which
# `just wasm-build` writes with an explicit -o.
/backend/wasm
frontend/public/wasm_exec.js

# Node/Bun
node_modules/
frontend/**/dist/
frontend/**/.vite/
frontend/**/.cache/
*.tsbuildinfo

# Logs and temp
*.log
.tmp/
tmp/

# AI Agents
.claude/
.serena/

# Tooling
.trunk/

# Test output
playwright-report/
test-results/

# Local research downloads
docs/research/external/**
!docs/research/external/
!docs/research/external/README.md

docs/*.pdf
interoperability/
