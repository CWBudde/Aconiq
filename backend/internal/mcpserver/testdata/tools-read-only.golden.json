[
  {
    "name": "estimate_run",
    "annotations": {
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "experimental": {
          "description": "Opt in to a scaffold-tier standard. A scaffold is not an implementation of the method its name suggests; without this its run is refused.",
          "type": "boolean"
        },
        "params": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Parameters of the profile by name, each value as a string. Omitted ones take the default list_standards declares; provenance.json records the values the run resolved.",
          "type": "object"
        },
        "receiver_mode": {
          "description": "auto-grid (a receiver grid over the sources or the calc-area) or custom (the model's receiver features).",
          "minLength": 1,
          "type": "string"
        },
        "scenario_id": {
          "description": "The scenario to run; default in a new project.",
          "minLength": 1,
          "type": "string"
        },
        "standard_id": {
          "description": "A standard id from list_standards.",
          "minLength": 1,
          "type": "string"
        },
        "standard_profile": {
          "description": "One of that version's profiles, from list_standards.",
          "minLength": 1,
          "type": "string"
        },
        "standard_version": {
          "description": "One of the standard's versions, from list_standards.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "standard_id",
        "standard_version",
        "standard_profile",
        "receiver_mode"
      ],
      "type": "object"
    }
  },
