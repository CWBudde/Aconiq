# Pinned developer toolchain — the single source of truth for tool versions.
#
# Both CI (.github/workflows/go-ci.yml) and the local workflow read this file,
# so a bump happens in one place and cannot drift between them. `just
# check-tools` verifies what is installed against it and `just install-tools`
# installs exactly these versions.
#
# The format is deliberately plain KEY=value so the file can be `source`d by a
# shell, loaded by just as a dotenv, and appended to $GITHUB_ENV. Anything but
# KEY=value (this comment block included) is filtered out before that append.

# Task runner.
JUST_VERSION=1.42.4

# Frontend runtime and package manager.
BUN_VERSION=1.3.7

# Linting.
GOLANGCI_LINT_VERSION=v2.12.2

# Formatters driven by treefmt. Every one of these changes the bytes `just fmt`
# writes, so a mismatch here is a diff CI rejects — see docs/policies/formatting.md.
TREEFMT_VERSION=v2.5.0
GOFUMPT_VERSION=v0.10.0
GCI_VERSION=v0.14.0
SHFMT_VERSION=v3.12.0
SHELLCHECK_VERSION=v0.11.0
PRETTIER_VERSION=3.8.0

# Supply-chain gates.
GO_LICENSES_VERSION=v1.6.0
GOVULNCHECK_VERSION=v1.7.0

# Release tooling.
GORELEASER_VERSION=v2.18.0
